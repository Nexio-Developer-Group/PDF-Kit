  ,"about_pdf_kit_permission_photos_title": "फोटो / इमेज"
  ,"about_pdf_kit_permission_photos_purpose": "इमेज से जुड़े ऑपरेशन के लिए इस्तेमाल होता है।"
  ,"about_pdf_kit_permission_videos_title": "वीडियो"
